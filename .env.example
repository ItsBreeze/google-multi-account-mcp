# ─── Required ───────────────────────────────────────────────────────────────

# Postgres. The four tables create themselves on boot.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# The public origin this server is reachable at — scheme and host only, no
# path, no trailing slash. It becomes the OAuth issuer and the Google redirect
# URI, so it must match what is registered with Google exactly.
PUBLIC_BASE_URL=https://your-deployment.example.com

# Google OAuth client of type "Web application", with the authorized redirect
# URI set to exactly <PUBLIC_BASE_URL>/gmail/oauth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# The passphrase that gates linking an account and approving Claude's OAuth
# consent. This is the only thing standing between a stranger who finds the URL
# and your mailboxes — make it long and random.
MCP_ADMIN_PASSWORD=

# 32 bytes, base64. Encrypts Google refresh and access tokens at rest, so the
# database never holds a usable token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this means every linked account must be linked again.
TOKEN_ENC_KEY=

# Base for the MCP token signing key, which is derived from it by HMAC rather
# than used directly — so that mounting this inside an app that signs its own
# tokens with the same secret cannot let a connector token pass as one of them.
# Any long random string.
JWT_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────

PORT=3000

# Off by default. When true, share_file may grant access to a whole domain or
# to anyone with the link — and even then only with confirm_public: true.
# Leave unset unless you need it: the grants it enables are one-way and do not
# look alarming in a tool result.
DRIVE_ALLOW_PUBLIC_SHARING=false
