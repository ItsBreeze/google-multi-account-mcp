{
  "name": "google-multi-account-mcp",
  "version": "1.0.0",
  "description": "A remote MCP server that gives Claude several Google accounts at once — Gmail, Calendar, Drive, Contacts and Tasks — where the first-party connectors hold one each",
  "main": "src/server.js",
  "license": "MIT",
  "keywords": ["mcp", "model-context-protocol", "claude", "google", "gmail", "google-drive", "google-calendar", "connector"],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test:mcp": "node test/mcp_oauth.e2e.js",
    "test:accounts": "node test/gmail_accounts.test.js",
    "test:tokens": "node test/token_separation.test.js",
    "test:query": "node test/gmail_query.test.js",
    "test:mime": "node test/gmail_mime.test.js",
    "test:threads": "node test/gmail_threads.test.js",
    "test:products": "node test/google_products.test.js",
    "test:drive-safety": "node test/drive_safety.test.js",
    "test:extract": "node test/text_extract.test.js",
    "test:drive-parity": "node test/drive_parity.test.js",
    "test:reach": "node test/shared_drives_recurrence.test.js",
    "test:ownership": "node test/ownership.test.js",
    "smoke": "node test/smoke_live.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  }
}
